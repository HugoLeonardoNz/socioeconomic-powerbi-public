  "visualStyles": {
    "*": {
      "*": {
        "title": [
          {
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 12,
            "fontColor": "#242321",
            "alignment": "left"
          }
        ],
        "background": [
          {
            "show": true,
