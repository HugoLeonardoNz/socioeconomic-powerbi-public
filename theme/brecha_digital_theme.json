{
  "name": "Brecha Digital",
  "dataColors": [
    "#0F5F52",
    "#C8763C",
    "#40697F",
    "#B8A055",
    "#8C6A93",
    "#7A9E7E",
    "#9C3D2E",
    "#6E8CA0",
    "#A8B5A2",
    "#D0A87C",
    "#7E93A6",
    "#B9A6BE"
  ],
  "foreground": "#1B1D21",
  "foregroundNeutralSecondary": "#5B616B",
  "foregroundNeutralTertiary": "#8D939C",
  "background": "#F5F2EC",
  "backgroundLight": "#FFFFFF",
  "backgroundNeutral": "#E0D8C8",
  "tableAccent": "#0F5F52",
  "good": "#0F5F52",
  "neutral": "#B8A055",
  "bad": "#B45309",
  "maximum": "#0F5F52",
  "center": "#9CBBB2",
  "minimum": "#F0EDE6",
  "null": "#C9C2B6",
  "hyperlink": "#0F5F52",
  "textClasses": {
    "title": {
      "fontFace": "Georgia",
      "fontSize": 13,
      "color": "#1B1D21"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 10,
      "color": "#5B616B"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 10,
      "color": "#5B616B"
    },
    "callout": {
      "fontFace": "Georgia",
      "fontSize": 34,
      "color": "#1B1D21"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E0D8C8"
              }
            },
            "radius": 20
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "visualHeader": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#1B1D21"
              }
            },
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontFamily": "Georgia",
            "fontSize": 13,
            "alignment": "left"
          }
        ],
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#5B616B"
              }
            },
            "fontSize": 9,
            "fontFamily": "Segoe UI"
          }
        ],
        "categoryAxis": [
          {
            "show": true,
            "labelColor": {
              "solid": {
                "color": "#5B616B"
              }
            },
            "fontSize": 9,
            "showAxisTitle": false,
            "gridlineShow": false
          }
        ],
        "valueAxis": [
          {
            "show": true,
            "labelColor": {
              "solid": {
                "color": "#5B616B"
              }
            },
            "fontSize": 9,
            "showAxisTitle": false,
            "gridlineColor": {
              "solid": {
                "color": "#EDE8DE"
              }
            },
            "gridlineThickness": 1,
            "gridlineStyle": "solid"
          }
        ],
        "legend": [
          {
            "show": true,
            "labelColor": {
              "solid": {
                "color": "#5B616B"
              }
            },
            "fontSize": 9,
            "showTitle": false,
            "position": "TopLeft"
          }
        ],
        "outline": [
          {
            "show": false
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F5F2EC"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#EBE6DC"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#1B1D21"
              }
            },
            "fontSize": 34,
            "fontFamily": "Georgia"
          }
        ],
        "categoryLabels": [
          {
            "show": false
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#EDE8DE"
              }
            },
            "outlineColor": {
              "solid": {
                "color": "#E0D8C8"
              }
            },
            "rowPadding": 7
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#8D939C"
              }
            },
            "backColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontSize": 9,
            "fontFamily": "Segoe UI Semibold"
          }
        ]
      }
    }
  }
}